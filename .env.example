# Trust configuration. Copy this file to .env.local and fill in your key.

# Free key from Google AI Studio (aistudio.google.com). Never commit it.
GEMINI_API_KEY=

# Optional: the fast model reads first; the careful model is the backup and gives a second opinion on shaky pages.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Optional: minimum gap between AI requests in milliseconds (protects the free quota).
GEMINI_MIN_GAP_MS=1200
